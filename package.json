{
  "name": "browzify",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "browzify": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "eval": "npx lmnr eval",
    "eval:file-tools": "npx lmnr eval evals/file-tools.eval.ts",
    "eval:shell-tools": "npx lmnr eval evals/shell-tools.eval.ts",
    "eval:agent": "npx lmnr eval evals/agent-multiturn.eval.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iannyFARUE/browzify.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/shelljs": "^0.10.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.66",
    "@lmnr-ai/lmnr": "^0.8.26",
    "ai": "^6.0.191",
    "ink": "^7.0.4",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.6",
    "shelljs": "^0.10.0",
    "zod": "^4.4.3"
  }
}
